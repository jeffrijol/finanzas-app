---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Finanzas App" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="bg-slate-50 min-h-screen font-sans text-slate-900">
        <div class="flex h-screen overflow-hidden">
            <!-- Sidebar placeholder -->
            <aside class="w-64 bg-white border-r hidden md:block">
                <div class="p-6">
                    <h1 class="text-2xl font-bold text-blue-600">Finanzas</h1>
                </div>
                <nav class="px-4 space-y-2">
                    <a
                        href="/"
                        class="block px-4 py-2 rounded-md hover:bg-slate-100"
                        >Dashboard</a
                    >
                    <a
                        href="/transactions"
                        class="block px-4 py-2 rounded-md hover:bg-slate-100"
                        >Transacciones</a
                    >
                    <a
                        href="/upload"
                        class="block px-4 py-2 rounded-md hover:bg-slate-100"
                        >Subir Archivo</a
                    >
                    <a
                        href="/analytics"
                        class="block px-4 py-2 rounded-md hover:bg-slate-100"
                        >Análisis</a
                    >
                </nav>
            </aside>

            <!-- Main Content -->
            <main class="flex-1 overflow-y-auto p-8">
                <slot />
            </main>
        </div>
    </body>
</html>
