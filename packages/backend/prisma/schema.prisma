generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id             String   @id @default(cuid())
  fechaValor     DateTime
  categoria      String   // Categoria original del banco
  descripcion    String
  importe        Float
  saldo          Float
  
  // Relacion Item
  itemAsignadoId String?
  itemAsignado   Item?    @relation(fields: [itemAsignadoId], references: [id], onDelete: SetNull)
  
  // Relacion Categoria Interna (Nueva)
  categoryId     String?
  categoryRel    TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  metadata       String?    // Para almacenar datos adicionales del Excel (JSON stringified)
  excelUploadId  String?
  excelUpload    ExcelUpload? @relation(fields: [excelUploadId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fechaValor])
  @@index([categoria])
  @@index([itemAsignadoId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([excelUploadId])
}

model Item {
  id          String       @id @default(cuid())
  nombre      String       @unique
  descripcion String?
  
  // Nuevo modelo de tipos
  itemTypeId  String
  itemType    ItemType     @relation(fields: [itemTypeId], references: [id])
  
  activo      Boolean      @default(true)
  color       String?      // Para identificación visual
  icono       String?      // Icono para la UI
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  transactions Transaction[]
}

model ItemType {
  id          String   @id @default(cuid())
  name        String   // Nombre visual: "Inmueble"
  code        String   @unique // Clave interna: "INMUEBLE"
  description String?
  items       Item[]
  categories  TransactionCategory[]
}

model TransactionCategory {
  id          String   @id @default(cuid())
  name        String   // "Alquiler", "IBI"
  type        String   // "INCOME", "EXPENSE"
  itemTypeId  String
  itemType    ItemType @relation(fields: [itemTypeId], references: [id])
  transactions Transaction[]

  @@unique([name, itemTypeId, type])
}

model ExcelUpload {
  id         String   @id @default(cuid())
  filename   String
  fileSize   Int
  totalRows  Int
  processed  Boolean  @default(false)
  errors     String?    // Errores durante el procesamiento (JSON stringified)
  userId     String?  // Si implementas autenticación
  createdAt  DateTime @default(now())
  transactions Transaction[]
}