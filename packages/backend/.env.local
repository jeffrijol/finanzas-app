# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO - BACKEND
# Este archivo es seguro para subir al repositorio.
# Copia este archivo como .env y rellena los valores reales.
# ============================================================

# ------------------------------------------------------------
# BASE DE DATOS - Supabase Connection Pooler (RECOMENDADO)
# ------------------------------------------------------------
# IMPORTANTE: Usa el Pooler (no la conexión directa) para
# compatibilidad con redes IPv4 (la mayoría de redes locales).
#
# El host puede ser aws-0 o aws-1 según tu despliegue de Supavisor.
# Encuéntralo en: Supabase Dashboard > Connect > Prisma
#
# Formato del usuario: postgres.[PROJECT-REF]
# Formato del host:    aws-[N]-[REGION].pooler.supabase.com
#
# Transaction mode (para queries de aplicación):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session mode (para migraciones y prepared statements):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------
# SUPABASE CLIENT
# ------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:4321"
UPLOAD_MAX_SIZE=10485760

# ------------------------------------------------------------
# ADMIN (Opcional)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@tu-dominio.com
# ADMIN_USER_IDS=uuid-1,uuid-2
